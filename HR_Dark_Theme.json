{
  "name": "HR Analytics Dark",
  "dataColors": [
    "#6366F1",
    "#F43F5E",
    "#22C55E",
    "#F59E0B",
    "#38BDF8",
    "#EC4899",
    "#A78BFA",
    "#34D399"
  ],
  "background": "#0A1628",
  "foreground": "#FFFFFF",
  "tableAccent": "#6366F1",
  "bad": "#F43F5E",
  "neutral": "#94A3B8",
  "good": "#22C55E",
  "maximum": "#22C55E",
  "center": "#F59E0B",
  "minimum": "#F43F5E",
  "null": "#1E3A5F",
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#162843" } }, "transparency": 0 }],
        "border": [{ "color": { "solid": { "color": "#1E3A5F" } }, "show": true }],
        "title": [{
          "fontColor": { "solid": { "color": "#818CF8" } },
          "background": { "solid": { "color": "#162843" } },
          "fontSize": 12,
          "fontFamily": "Segoe UI Semibold",
          "alignment": "left"
        }]
      }
    },
    "card": {
      "*": {
        "calloutValue": [{
          "fontSize": 22,
          "fontFamily": "Segoe UI Bold",
          "color": { "solid": { "color": "#818CF8" } }
        }],
        "label": [{
          "fontSize": 10,
          "fontFamily": "Segoe UI",
          "color": { "solid": { "color": "#94A3B8" } }
        }],
        "background": [{ "color": { "solid": { "color": "#162843" } }, "transparency": 0 }]
      }
    },
    "barChart": {
      "*": {
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#94A3B8" } }, "fontSize": 9 }],
        "valueAxis": [{
          "labelColor": { "solid": { "color": "#94A3B8" } },
          "fontSize": 9,
          "gridlineColor": { "solid": { "color": "#1E3A5F" } }
        }],
        "dataLabels": [{ "color": { "solid": { "color": "#FFFFFF" } }, "fontSize": 9 }]
      }
    },
    "columnChart": {
      "*": {
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#94A3B8" } }, "fontSize": 9 }],
        "valueAxis": [{
          "labelColor": { "solid": { "color": "#94A3B8" } },
          "fontSize": 9,
          "gridlineColor": { "solid": { "color": "#1E3A5F" } }
        }],
        "dataLabels": [{ "color": { "solid": { "color": "#FFFFFF" } }, "fontSize": 9 }]
      }
    },
    "donutChart": {
      "*": {
        "dataLabels": [{ "color": { "solid": { "color": "#FFFFFF" } }, "fontSize": 9 }]
      }
    },
    "slicer": {
      "*": {
        "data": [{
          "fontColor": { "solid": { "color": "#FFFFFF" } },
          "fontSize": 11,
          "fontFamily": "Segoe UI"
        }],
        "background": [{ "color": { "solid": { "color": "#1E3A5F" } }, "transparency": 0 }]
      }
    },
    "matrix": {
      "*": {
        "columnHeaders": [{
          "fontColor": { "solid": { "color": "#FFFFFF" } },
          "backColor": { "solid": { "color": "#1E3A5F" } },
          "fontSize": 10
        }],
        "rowHeaders": [{
          "fontColor": { "solid": { "color": "#FFFFFF" } },
          "backColor": { "solid": { "color": "#162843" } },
          "fontSize": 10
        }],
        "values": [{ "fontColor": { "solid": { "color": "#CBD5E1" } }, "fontSize": 10 }]
      }
    }
  }
}
